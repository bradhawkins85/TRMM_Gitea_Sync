# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and will not be committed.

# ── Tactical RMM ────────────────────────────────────────────────────────────
TRMM_API_URL=https://rmm.example.com
TRMM_API_KEY=your-trmm-api-key

# ── Gitea (sync.py) ─────────────────────────────────────────────────────────
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=your-gitea-access-token
GITEA_OWNER=your-gitea-user-or-org
GITEA_REPO=your-gitea-repo-name
GITEA_BRANCH=main
# Path to store a local git clone of the Gitea repo (default: ./gitea_repo).
# The repo is cloned automatically on first run; subsequent runs do a git pull.
GITEA_LOCAL_PATH=./gitea_repo
# Set to true to sync every script even when only some files changed (default: false).
FULL_SYNC=false
# Optional: override the path to the persistent JSON state file that tracks
# the repo-relative-path → TRMM script guid mapping across runs.  Defaults to
# a sibling of GITEA_LOCAL_PATH (e.g. ./.trmm_sync_state.json).
# SYNC_STATE_FILE=./.trmm_sync_state.json

# ── GitHub (sync_github.py) ─────────────────────────────────────────────────
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=your-github-repo-name
GITHUB_BRANCH=main
# Leave blank to use the default public GitHub API; set for GitHub Enterprise:
# GITHUB_API_URL=https://github.example.com/api/v3
# Optional: override the path to the persistent JSON state file used by
# sync_github.py (default: ./.trmm_github_sync_state.json).  When both
# sync.py and sync_github.py are run in the same directory, set distinct
# SYNC_STATE_FILE values for each.
# SYNC_STATE_FILE=./.trmm_github_sync_state.json

# ── SSL ─────────────────────────────────────────────────────────────────────
# Set to true to disable SSL certificate verification (not recommended for production)
IGNORE_SSL=false
